# Application Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (MySQL / MAMP or Cloud)
DATABASE_URL="mysql://root:root@localhost:3306/sunday_school"

# JWT Authentication (generate 64-character hex strings in production)
JWT_ACCESS_SECRET="example_jwt_access_secret_min_32_characters_long_12345"
JWT_REFRESH_SECRET="example_jwt_refresh_secret_min_32_characters_long_67890"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Administrator Seed Credentials
ADMIN_INITIAL_EMAIL="admin@abunemedia.org"
ADMIN_INITIAL_PASSWORD="SecureAdminPassword123!"
ADMIN_INITIAL_NAME="System Administrator"
ADMIN_INITIAL_ROLE="SUPER_ADMIN"

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# CORS Configuration (Set to frontend URL)
CORS_ORIGIN="http://localhost:3000"

# Cloudinary Storage Credentials (Optional, falls back to local disk upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
