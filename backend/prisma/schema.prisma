generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model Admin {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  name                  String
  role                  AdminRole              @default(ADMIN)
  isActive              Boolean                @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  refreshTokens         RefreshToken[]
  announcements         Announcement[]
  attendanceSessions    AttendanceSession[]
  attendanceCorrections AttendanceCorrection[]

  @@map("admins")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique
  adminId             String
  admin               Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  @@index([adminId])
  @@map("refresh_tokens")
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  summary     String?   @db.Text
  category    String    @default("General")
  imageUrl    String?
  isPinned    Boolean   @default(false)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  isArchived  Boolean   @default(false)
  createdById String?
  createdBy   Admin?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, isArchived, publishedAt, expiresAt])
  @@index([isPinned])
  @@map("announcements")
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String    @db.Text
  location    String
  startDate   DateTime
  endDate     DateTime?
  isPublished Boolean   @default(false)
  imageUrl    String?
  category    String    @default("General")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, startDate])
  @@map("events")
}

model Report {
  id          String   @id @default(uuid())
  title       String
  summary     String?  @db.Text
  content     String   @db.Text
  category    String   @default("General")
  fileUrl     String?
  reportDate  DateTime
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, reportDate])
  @@map("reports")
}

model Mezmur {
  id            String   @id @default(uuid())
  title         String
  originalTitle String?
  lyrics        String   @db.Text
  category      String   @default("General")
  artistChoir   String?
  audioUrl      String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished, category])
  @@map("mezmurs")
}

model Teaching {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  author      String?
  category    String   @default("General")
  mediaUrl    String?
  isPublished Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@map("teachings")
}

model GalleryAlbum {
  id            String         @id @default(uuid())
  title         String
  description   String?        @db.Text
  coverImageUrl String?
  eventDate     DateTime?
  isPublished   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  photos        GalleryPhoto[]

  @@index([isPublished])
  @@map("gallery_albums")
}

model GalleryPhoto {
  id        String       @id @default(uuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  title     String?
  imageUrl  String
  caption   String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([albumId, sortOrder])
  @@map("gallery_photos")
}

model Schedule {
  id           String    @id @default(uuid())
  title        String
  activity     String
  dayOfWeek    String?
  specificDate DateTime?
  startTime    String
  endTime      String
  targetGroup  String?
  location     String?
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished])
  @@map("schedules")
}

enum RegistrationType {
  SHORT_TERM
  LONG_TERM
}

enum AgeDivision {
  CHILDREN
  INTERMEDIATE
  YOUTH
}

enum Gender {
  MALE
  FEMALE
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

model MemberRegistration {
  id                 String           @id @default(uuid())
  registrationNumber String           @unique
  registrationType   RegistrationType @default(LONG_TERM)
  division           AgeDivision
  status             MemberStatus     @default(PENDING)

  // መሰረታዊ የአባሉ መረጃ (Member Personal Info)
  fullName           String
  christianName      String
  gender             Gender
  age                Int
  dateOfBirth        DateTime?
  motherName         String?
  phoneNumber        String?
  photoUrl           String?
  schoolOrOccupation String?
  passwordHash       String?

  // የንስሐ አባት መረጃ (Confession Father Info)
  confessionFather  String
  confessionChurch  String?
  confessionAddress String?

  // አድራሻ (Residential Address)
  address     String
  kebele      String?
  houseNumber String?

  // የአገልግሎት እና የሰንበት ት/ቤት መረጃ (Service & Church Info)
  admissionDate       DateTime?
  formFilledDate      DateTime  @default(now())
  preferredDepartment String?
  talentSkills        String?   @db.Text

  // የቅርብ ተጠሪ መረጃ (Emergency Contact / Guardian)
  emergencyContactName  String
  emergencyRelationship String?
  emergencyContactPhone String

  // የፈቃደኝነት እና ማረጋገጫ (Consent & Declarations)
  parentName          String?
  parentConsent       Boolean   @default(false)
  parentSignatureDate DateTime?

  youthCovenantAccepted Boolean   @default(false)
  youthSignatureDate    DateTime?

  // የአስተዳደር ማጽደቂያ (Official Approval Section)
  approvedByName       String?
  approverRole         String?
  approvalDate         DateTime?
  chairmanName         String?
  chairmanApprovalDate DateTime?
  adminNotes           String?   @db.Text

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceRecords AttendanceRecord[]

  @@index([status, division, registrationType])
  @@index([registrationNumber])
  @@map("member_registrations")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model AttendanceSession {
  id          String             @id @default(uuid())
  sessionDate DateTime           @db.Date
  division    AgeDivision
  groupName   String
  department  String
  className   String
  sessionType String
  createdById String
  createdBy   Admin              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  records     AttendanceRecord[]
  createdAt   DateTime           @default(now())

  @@unique([sessionDate, division, groupName, className, sessionType])
  @@index([division, sessionDate])
  @@index([className, sessionDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id          String                 @id @default(uuid())
  sessionId   String
  session     AttendanceSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId    String
  member      MemberRegistration     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  status      AttendanceStatus
  updatedAt   DateTime               @updatedAt
  corrections AttendanceCorrection[]

  @@unique([sessionId, memberId])
  @@index([memberId, status])
  @@map("attendance_records")
}

model AttendanceCorrection {
  id                 String           @id @default(uuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  previousStatus     AttendanceStatus
  newStatus          AttendanceStatus
  reason             String           @db.Text
  correctedById      String
  correctedBy        Admin            @relation(fields: [correctedById], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@index([attendanceRecordId, createdAt])
  @@map("attendance_corrections")
}
