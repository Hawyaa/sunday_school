generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model Admin {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         AdminRole      @default(ADMIN)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  announcements Announcement[]

  @@map("admins")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique
  adminId             String
  admin               Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  @@index([adminId])
  @@map("refresh_tokens")
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  summary     String?   @db.Text
  category    String    @default("General")
  imageUrl    String?
  isPinned    Boolean   @default(false)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  isArchived  Boolean   @default(false)
  createdById String?
  createdBy   Admin?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, isArchived, publishedAt, expiresAt])
  @@index([isPinned])
  @@map("announcements")
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String    @db.Text
  location    String
  startDate   DateTime
  endDate     DateTime?
  isPublished Boolean   @default(false)
  imageUrl    String?
  category    String    @default("General")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, startDate])
  @@map("events")
}

model Report {
  id          String   @id @default(uuid())
  title       String
  summary     String?  @db.Text
  content     String   @db.Text
  category    String   @default("General")
  fileUrl     String?
  reportDate  DateTime
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, reportDate])
  @@map("reports")
}

model Mezmur {
  id            String   @id @default(uuid())
  title         String
  originalTitle String?
  lyrics        String   @db.Text
  category      String   @default("General")
  artistChoir   String?
  audioUrl      String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished, category])
  @@map("mezmurs")
}

model Teaching {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  author      String?
  category    String   @default("General")
  mediaUrl    String?
  isPublished Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@map("teachings")
}

model GalleryAlbum {
  id            String         @id @default(uuid())
  title         String
  description   String?        @db.Text
  coverImageUrl String?
  eventDate     DateTime?
  isPublished   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  photos        GalleryPhoto[]

  @@index([isPublished])
  @@map("gallery_albums")
}

model GalleryPhoto {
  id        String       @id @default(uuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  title     String?
  imageUrl  String
  caption   String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([albumId, sortOrder])
  @@map("gallery_photos")
}

model Schedule {
  id           String    @id @default(uuid())
  title        String
  activity     String
  dayOfWeek    String?
  specificDate DateTime?
  startTime    String
  endTime      String
  targetGroup  String?
  location     String?
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished])
  @@map("schedules")
}
